NODE_ENV=development

# Database 1 (Auth/Users)
DB1_HOST=localhost
DB1_PORT=3306
DB1_NAME=template_auth
DB1_USER=bpo_app
DB1_PASSWORD=123456

# Database 2 (Content)
DB2_HOST=localhost
DB2_PORT=3306
DB2_NAME=template_content
DB2_USER=your_db_user
DB2_PASSWORD=your_db_password

# JWT Secrets - use long random strings in production (openssl rand -hex 64)
ACCESS_TOKEN_SECRET=change_this_access_secret_in_production
REFRESH_TOKEN_SECRET=change_this_refresh_secret_in_production
EMAIL_VERIFY_SECRET=change_this_email_verify_secret_in_production

# Token durations (seconds)
ACCESS_TOKEN_DURATION=60
REFRESH_TOKEN_DURATION=1200

# Security
BCRYPT_SALT_ROUNDS=12
FRONTEND_URL=http://localhost:4200

# Server
PORT=8080
